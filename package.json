{
  "name": "neon-nexus",
  "private": true,
  "description": "Development checks for the client-side game",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "music:convert": "node tools/music.cjs",
    "build:website": "node tools/ci/package.cjs --minify --with-music",
    "check:syntax": "node tools/ci/syntax.cjs",
    "lint": "eslint .",
    "test:unit": "node tools/ci/unit.cjs",
    "test:browser": "playwright test",
    "check": "npm run check:syntax && npm run lint && npm run test:unit && npm run test:browser",
    "prepare": "node tools/ci/install-hooks.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "clean-css": "5.3.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-minifier-terser": "7.2.0",
    "terser": "5.51.2"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
